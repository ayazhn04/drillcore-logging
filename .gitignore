/data/
/outputs/
/runs/
*.CR2
*.cr2
*.CR3
*.NEF
*.DNG
*.tif
*.tiff
*.jpg
*.jpeg
*.png
!docs/img/*.png
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
.env
.env.*
*.key
*.pem
credentials*
secrets*

# Local configs with machine-specific paths (copy from configs/lab.example.yaml)
configs/local*.yaml
configs/lab.yaml

# Python / tooling
.venv/
venv/
__pycache__/
*.egg-info/
.pytest_cache/
